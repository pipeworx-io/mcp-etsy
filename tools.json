[
  {
    "name": "etsy_search_listings",
    "description": "Search active Etsy listings site-wide (Etsy Open API v3, findAllListingsActive). Requires an Etsy API key — pass your keystring as _apiKey (x-api-key auth only, no OAuth). No sold-price data — active listings only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "keywords": {
          "type": "string",
          "description": "Search term/phrase, e.g. \"vintage brass lamp\""
        },
        "limit": {
          "type": "number",
          "description": "1-100 (default 25)"
        },
        "offset": {
          "type": "number",
          "description": "Records to skip (default 0)"
        },
        "sort_on": {
          "type": "string",
          "description": "created (default) | price | updated | score"
        },
        "sort_order": {
          "type": "string",
          "description": "asc | desc (default desc); only applies alongside keywords/region"
        },
        "min_price": {
          "type": "number",
          "description": "Minimum price"
        },
        "max_price": {
          "type": "number",
          "description": "Maximum price"
        },
        "taxonomy_id": {
          "type": "number",
          "description": "Etsy taxonomy (category) ID"
        },
        "buyer_country": {
          "type": "string",
          "description": "ISO 3166-1 alpha-2, e.g. \"US\" — filters to listings that ship there"
        }
      },
      "required": []
    }
  },
  {
    "name": "etsy_search_shop_listings",
    "description": "Search a specific Etsy shop's active listings by shop ID (Etsy Open API v3, findAllActiveListingsByShop). Requires an Etsy API key. Use etsy_search_listings first if you don't already have a shop_id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "shop_id": {
          "type": "number",
          "description": "Numeric Etsy shop ID"
        },
        "keywords": {
          "type": "string",
          "description": "Search term to filter this shop's listings"
        },
        "limit": {
          "type": "number",
          "description": "1-100 (default 25)"
        },
        "offset": {
          "type": "number",
          "description": "Records to skip (default 0)"
        },
        "sort_on": {
          "type": "string",
          "description": "created (default) | price | updated | score"
        },
        "sort_order": {
          "type": "string",
          "description": "asc | desc"
        }
      },
      "required": [
        "shop_id"
      ]
    }
  },
  {
    "name": "etsy_get_listing",
    "description": "Get one Etsy listing by its numeric listing ID (Etsy Open API v3, getListing). Requires an Etsy API key.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "listing_id": {
          "type": "number",
          "description": "Numeric Etsy listing ID"
        }
      },
      "required": [
        "listing_id"
      ]
    }
  }
]
